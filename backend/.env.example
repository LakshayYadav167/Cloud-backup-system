# ==============================================================================
# Cloud Backup System - Backend Environment Configuration
# ₹0 Budget Project: Local resources only
# ==============================================================================

APP_NAME="Cloud Backup System API"
APP_VERSION="1.0.0"
APP_ENV=development
DEBUG=true

# Server Binding
HOST=127.0.0.1
PORT=8000

# SQLite Database Location
DATABASE_URL=sqlite:///./data/cloud_backup.db

# Storage Abstraction: "local" (default) or "s3" (optional local MinIO/S3)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/storage
MAX_UPLOAD_SIZE_MB=50

# Optional S3 / MinIO Configuration (Active only when STORAGE_PROVIDER=s3)
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=cloud-backup-system
S3_REGION=us-east-1
S3_USE_SSL=false

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
