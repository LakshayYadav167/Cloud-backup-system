# ==============================================================================
# Cloud Backup System - Backend Environment Configuration
# ₹0 Budget Project: Local resources only
# ==============================================================================

APP_NAME="Cloud Backup System API"
APP_VERSION="1.0.0"
APP_ENV=development
DEBUG=true

# Server Binding
HOST=127.0.0.1
PORT=8000

# SQLite Database Location
DATABASE_URL=sqlite:///./data/cloud_backup.db

# ------------------------------------------------------------------------------
# Storage Provider Selection:
# - "local": Default, stores files on local disk at LOCAL_STORAGE_PATH.
# - "s3":    Connects to local Floci AWS emulator via S3CompatibleStorage (boto3).
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/storage
MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------------------------
# Floci / Local S3 Configuration (Active only when STORAGE_PROVIDER=s3)
#
# Floci emulator endpoint:
# - When running backend on Windows host:    http://127.0.0.1:4566
# - When running backend inside container:   http://floci:4566
# Development credentials: "test" / "test"
# Path-style addressing: enabled by default in S3CompatibleStorage
# ------------------------------------------------------------------------------
S3_ENDPOINT_URL=http://127.0.0.1:4566
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET_NAME=cloud-backup-system
S3_REGION=us-east-1
S3_USE_SSL=false

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://127.0.0.1:80
