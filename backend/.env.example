# ==============================================================================
# Cloud Backup System - Backend Specific Environment Configuration
# ₹0 Budget Project: Local resources only
# ==============================================================================

APP_NAME="Cloud Backup System API"
APP_VERSION="1.0.0"
APP_ENV=development
DEBUG=true

# Server Binding
HOST=127.0.0.1
PORT=8000

# SQLite Database Location
DATABASE_URL=sqlite:///./data/cloud_backup.db

# Storage Abstraction
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/storage
MAX_UPLOAD_SIZE_MB=50

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
