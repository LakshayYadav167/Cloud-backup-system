# ==============================================================================
# Cloud Backup System - Root Environment Configuration Example
# ₹0 Budget Project: All services use local resources, no paid cloud accounts needed
# Copy this file to .env for local overrides (never commit .env to Git)
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_NAME="Cloud Backup System"
APP_VERSION=1.0.0

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_RELOAD=true

# Frontend Server Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Database Configuration (Zero-Cost SQLite database stored locally)
DATABASE_URL=sqlite:///./data/cloud_backup.db

# Storage Provider Configuration
# Supported providers: "local" (future extensions may include "minio", "s3_compatible")
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/storage
MAX_UPLOAD_SIZE_MB=50

# Security & CORS (Local development domains only)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECRET_KEY=college-project-dev-secret-change-in-production-only-placeholder
