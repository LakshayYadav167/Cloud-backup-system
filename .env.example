# ==============================================================================
# Cloud Backup System - Root Environment Configuration Example
# ₹0 Budget Project: All services use local resources, no paid cloud accounts needed
# Copy this file to .env for local overrides (never commit .env to Git)
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_NAME="Cloud Backup System"
APP_VERSION=1.0.0

# Backend Server Configuration (FastAPI)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_RELOAD=true

# Frontend Server Configuration (Vite + React)
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Database Configuration (Zero-cost SQLite database stored locally in WAL mode)
DATABASE_URL=sqlite:///./data/cloud_backup.db

# ------------------------------------------------------------------------------
# Storage Provider Configuration:
# - "local": Default, ₹0 dependencies, stores files directly in LOCAL_STORAGE_PATH.
# - "s3":    Optional local AWS/S3 emulator (Floci or LocalStack) via boto3.
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/storage
MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------------------------
# Floci / Local S3-Compatible Storage Configuration
# (Active only when STORAGE_PROVIDER=s3)
#
# Floci is an open-source (MIT license, ₹0 cost) local AWS emulator running on port 4566.
# - Host endpoint (running backend directly on Windows): http://127.0.0.1:4566
# - Docker Compose internal endpoint (running backend in container): http://floci:4566
# - Path-style addressing is explicitly enabled in S3CompatibleStorage.
# - Development-only dummy credentials: "test" / "test" (never use real AWS credentials).
# - Verified persistence settings in Floci container:
#     FLOCI_STORAGE_MODE=persistent
#     FLOCI_STORAGE_PERSISTENT_PATH=/app/data
#     Volume: floci_data:/app/data
# ------------------------------------------------------------------------------
S3_ENDPOINT_URL=http://127.0.0.1:4566
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET_NAME=cloud-backup-system
S3_REGION=us-east-1
S3_USE_SSL=false

# Security & CORS (Local development domains only)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://127.0.0.1:80
SECRET_KEY=college-project-dev-secret-change-in-production-only-placeholder
