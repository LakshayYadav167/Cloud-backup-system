# ==============================================================================
# Cloud Backup System - Frontend Dockerfile
# Multi-stage Vite build + Nginx Alpine (Zero-cost, lightweight)
# ==============================================================================

# Stage 1: Build the React + TypeScript SPA bundle
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency specifications and install
COPY package*.json ./
RUN npm install

# Copy source code and build production assets
COPY . .
RUN npm run build

# Stage 2: Serve using Nginx Alpine
FROM nginx:1.27-alpine AS runtime

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy built application assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration with reverse proxy for /api/
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
