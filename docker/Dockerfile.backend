# ==============================================================================
# Cloud Backup System - Backend Dockerfile
# Multi-stage lightweight Python container (Zero-cost, open-source)
# ==============================================================================

FROM python:3.12-slim AS builder

WORKDIR /build

# Install build dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# Final runtime image
FROM python:3.12-slim AS runtime

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

# Copy installed dependencies from builder
COPY --from=builder /install /usr/local

# Copy application code
COPY app /app/app

# Create data directories with appropriate permissions
RUN mkdir -p /app/data/storage

# Expose backend REST API port
EXPOSE 8000

# Health check using native python
HEALTHCHECK --interval=10s --timeout=3s --retries=5 --start-period=5s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health')" || exit 1

# Launch production-grade ASGI server
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
